# Copie para ".env" e ajuste. O arquivo .env NÃO deve ir para o GitHub.
# Gere uma chave com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
# 1 = modo desenvolvimento (recarrega sozinho e mostra erros); 0 = desligado
FLASK_DEBUG=1
# Use 1 somente quando o portal estiver publicado com HTTPS.
COOKIE_SECURE=0

# Credenciais em Email Testing > Inboxes > SMTP Settings no Mailtrap.
# Use a caixa Sandbox: as mensagens ficam capturadas para testes, sem entrega real.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_FROM_EMAIL=portal@horizonteeducacional.test
MAILTRAP_FROM_NAME=Horizonte Educacional
MAILTRAP_TO_EMAIL=destinatario@horizonteeducacional.test
